<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filter Incidents"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primaryColor"
            android:fontFamily="@font/inter_bold"
            android:layout_marginBottom="16dp" />

        <!-- Date Filter Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date Range"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/darkGray"
            android:fontFamily="@font/inter_bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flexWrap="wrap"
            android:layout_marginBottom="16dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/dialog_chip_all_time"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Time"
                android:layout_margin="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/dialog_chip_today"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:layout_margin="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/dialog_chip_this_week"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This Week"
                android:layout_margin="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/dialog_chip_this_month"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This Month"
                android:layout_margin="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/dialog_chip_this_year"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This Year"
                android:layout_margin="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/dialog_chip_custom_date"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom Range"
                android:layout_margin="4dp" />

        </com.google.android.flexbox.FlexboxLayout>

        <!-- Status Filter Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/darkGray"
            android:fontFamily="@font/inter_bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flexWrap="wrap"
            android:layout_marginBottom="16dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/dialog_chip_all_status"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Status"
                android:layout_margin="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/dialog_chip_pending"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:layout_margin="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/dialog_chip_ongoing"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ongoing"
                android:layout_margin="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/dialog_chip_resolved"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resolved"
                android:layout_margin="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/dialog_chip_false_alarm"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="False Alarm"
                android:layout_margin="4dp" />

        </com.google.android.flexbox.FlexboxLayout>

        <!-- Location Filter Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Relocation Location"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/darkGray"
            android:fontFamily="@font/inter_bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flexWrap="wrap"
            android:layout_marginBottom="16dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/dialog_chip_all_locations"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Locations"
                android:layout_margin="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/dialog_chip_location_gym"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gym"
                android:layout_margin="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/dialog_chip_location_field"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Field"
                android:layout_margin="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/dialog_chip_location_student_lounge"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Lounge"
                android:layout_margin="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/dialog_chip_location_clinic"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clinic"
                android:layout_margin="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/dialog_chip_location_other"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Other"
                android:layout_margin="4dp" />

        </com.google.android.flexbox.FlexboxLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_filters"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear All"
                android:textColor="@color/darkGray"
                android:fontFamily="@font/inter_bold"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_apply_filters"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apply"
                android:textColor="@android:color/white"
                android:fontFamily="@font/inter_bold"
                android:backgroundTint="@color/primaryColor"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
